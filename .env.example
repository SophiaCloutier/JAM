# Local MongoDB: run docker compose up -d first. Never commit .env.
MONGODB_URI=mongodb://127.0.0.1:27017/jam_alpha
MONGODB_DATABASE=jam_alpha
PORT=3000
# Use http://localhost:5173 when running the Vite dev server.
PUBLIC_ORIGIN=http://localhost:3000
# Comma-separated registered .edu emails allowed to run matching.
ADMIN_EMAILS=

EVENT_HOURS=2
CUTOFF_HOURS=8
# Optional: leave both empty for deterministic event copy.
OPENAI_API_KEY=
OPENAI_MODEL=
